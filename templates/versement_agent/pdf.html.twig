<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>État de versement Agent - Régisseur</title>

<style>

@page{
    margin:20px 20px 40px 20px;
}

body{
    font-family: Arial, sans-serif;
    font-size:12px;
    color:#000;
    margin:0;
}

/* ================= HEADER ================= */

.header{
    position:relative;
    height:180px;
    margin-bottom:20px;
}

.logo-left{
    position:absolute;
    left:0;
    top:40px;
    width:160px;
    text-align:center;
}

.logo-center{
    text-align:center;
}

.logo-right{
    position:absolute;
    right:0;
    top:40px;
    width:160px;
    text-align:center;
}

.header-title{
    margin-top:10px;
    font-size:14px;
    font-weight:bold;
    text-transform:uppercase;
    text-align:center;
}

/* ================= TITRES ================= */

.section-title{
    font-weight:bold;
    font-size:13px;
    text-decoration:underline;
    margin-bottom:8px;
}

strong{
    font-weight:bold;
}

/* ================= TABLE ================= */

table{
    width:100%;
    border-collapse:collapse;
    margin-top:15px;
}

thead{
    display:table-header-group;
}

tbody{
    display:table-row-group;
}

tr{
    page-break-inside:avoid;
}

table, th, td{
    border:1px solid #000;
}

th{
    background:#efefef;
    padding:7px;
}

td{
    padding:6px;
    text-align:center;
}

/* ================= STATUS ================= */

.success{
    color:green;
    font-weight:bold;
}

.danger{
    color:red;
    font-weight:bold;
}

/* ================= FOOTER ================= */

.footer{
    margin-top:10px;
}

.signature{
    width:100%;
    margin-top:10px;
}

.left-sign{
    width:45%;
    float:left;
    text-align:center;
}

.right-sign{
    width:45%;
    float:right;
    text-align:center;
}

.clear{
    clear:both;
}

.footer-fixed{
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    text-align:center;
    font-size:11px;
    border-top:1px solid #000;
    padding-top:5px;
}

</style>
</head>

<body>

<!-- ================= HEADER ================= -->
<div class="header">
    <!-- gauche -->
    <div class="logo-left">
        <img src="{{ absolute_url(asset('assets/images/logos/logo_mid.jpg')) }}"
             style="width:95px;">
        <div style="font-size:9px; line-height:1.2; margin-top:5px;">
            <strong>
                MINISTÈRE DE L’INTÉRIEUR<br>
                ET DE LA DÉCENTRALISATION
            </strong>
            <br><br>
            …………………………
            <br><br>
            <strong>RÉGION MELAKY</strong>
        </div>

    </div>

    <!-- centre -->
    <div class="logo-center">

        <img src="{{ absolute_url(asset('assets/images/logos/logo_centre.png')) }}"
             style="width:150px;">

        <div class="header-title">
            ÉTAT DE VERSEMENT EFFECTUÉ À LA TRÉSORERIE GÉNÉRALE DE MAINTIRANO
        </div>

    </div>

    <!-- droite -->
    <div class="logo-right">

        <img src="{{ absolute_url(asset('assets/images/logos/logo.jpeg')) }}"
             style="width:100px;">

    </div>

</div>

<!-- ================= INFOS ================= -->

<div>
    <strong>
        PRODUITS DE RISTOURNE : 7717<br>
        SOA : 20-17-2-000-41301<br>
        CIN: 421 012 002 761
    </strong>
</div>

<br>

<div>
    <div class="section-title">AGENT</div>

    Nom : {{ agent.nom }}<br>
    Localité : {{ agent.localite.district.nom }} - {{ agent.localite.nom }}
</div>

<br>

<div>
    <div class="section-title">CARNET DE QUITTANCE</div>

    N° Carnet :
    <strong>
        {{ versement.quittances|first.carnetQuittance.idCarnet ?? 'Non défini' }}
    </strong>
    <br>
    Statut :
    <strong>
        {{ versement.quittances|first.carnetQuittance.statut}}
    </strong> 
</div>

<!-- ================= TABLEAU ================= -->

<div style="text-align:center; margin-top:20px;">
    <div class="section-title">
        LISTE DES QUITTANCES CONCERNÉES
    </div>
</div>

<table>

<thead>
<tr>
    <th>#</th>
    <th>N° quittance</th>
    <th>Date</th>
    <th>Client</th>
    <th>Produit</th>
    <th>Qté</th>
    <th>Montant</th>
    <th>Statut</th>
</tr>
</thead>

<tbody>

{% set total = 0 %}

{% for q in versement.quittances %}

    {% set total = total + q.montantTotal %}

<tr>
    <td>{{ loop.index }}</td>
    <td>{{ q.numQuittance }}</td>
    <td>{{ q.dateUtilisation|date('d/m/Y') }}</td>
    <td>{{ q.nomClient }}</td>
    <td>{{ q.produit.nomProduit }}</td>
    <td>{{ q.quantite }} {{ q.produit.uniteMesure }}</td>
    <td>{{ q.montantTotal|number_format(0, ',', ' ') }} Ar</td>
    <td>
        {% if q.statut == 'versé' %}
            <span class="success">VERSÉ</span>
        {% else %}
            <span class="danger">{{ q.statut }}</span>
        {% endif %}
    </td>
</tr>

{% else %}

<tr>
    <td colspan="8">Aucune quittance disponible</td>
</tr>

{% endfor %}

<!-- total unique -->
<tr>
    <th colspan="6">TOTAL GÉNÉRAL</th>
    <th colspan="2">
        {{ total|number_format(0, ',', ' ') }} Ar
    </th>
</tr>
</tbody>
</table>

<!-- ================= FOOTER ================= -->

<div class="footer">
    <p>
        Arrêté le présent état à la somme de :
        <strong>{{ total|lettres }} Ariary</strong>
    </p>

    <div style="text-align:right;">
        Maintirano, le {{ versement.date |date("d/m/Y") }}
    </div>

    <div class="signature">

        <div class="left-sign">
            Vu et vérifié exact
        </div>

        <div class="right-sign">
            Le Régisseur
        </div>

        <div class="clear"></div>
    </div>
</div>
</body>
</html>